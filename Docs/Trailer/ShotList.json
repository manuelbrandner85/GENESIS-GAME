  "voiceover": [
    {"id": "VO_01a", "start": 3.0,   "speaker": "narrator", "text": "Bevor du deinen ersten Atemzug nahmst …"},
    {"id": "VO_01b", "start": 7.2,   "speaker": "narrator", "text": "… hatte deine Geschichte bereits begonnen."},
    {"id": "VO_M1",  "start": 23.2,  "speaker": "mother",   "text": "Ganz ruhig … ich bin bei dir.", "fx": "muffled"},
    {"id": "VO_02",  "start": 39.2,  "speaker": "narrator", "text": "Du wirst lieben."},
    {"id": "VO_03",  "start": 41.9,  "speaker": "narrator", "text": "Du wirst verlieren."},
    {"id": "VO_04",  "start": 48.8,  "speaker": "narrator", "text": "Du wirst Entscheidungen treffen …"},
    {"id": "VO_05",  "start": 51.2,  "speaker": "narrator", "text": "… deren Folgen du vielleicht erst Jahrzehnte später verstehst."},
    {"id": "VO_06",  "start": 63.2,  "speaker": "narrator", "text": "Doch kein Weg ist falsch."},
    {"id": "VO_07",  "start": 66.9,  "speaker": "narrator", "text": "Jeder Weg hinterlässt Spuren."},
    {"id": "VO_08",  "start": 73.8,  "speaker": "narrator", "text": "Am Ende bleiben nicht die Jahre."},
    {"id": "VO_09",  "start": 76.9,  "speaker": "narrator", "text": "Es bleiben die Augenblicke."},
    {"id": "VO_D1",  "start": 90.3,  "speaker": "daughter", "text": "Ich bin hier … ich bin hier.", "fx": "distant"},
    {"id": "VO_10",  "start": 99.8,  "speaker": "narrator", "text": "Und wenn du glaubst, dass alles vorbei ist …"},
    {"id": "VO_11",  "start": 103.6, "speaker": "narrator", "text": "… beginnt erst die nächste Reise."},
    {"id": "VO_12",  "start": 107.6, "speaker": "narrator", "text": "Und eines Tages …"},
    {"id": "VO_13",  "start": 110.2, "speaker": "narrator", "text": "… erschaffst du selbst Leben."},
    {"id": "VO_14",  "start": 118.2, "speaker": "child",    "text": "Kennen wir uns?"}
  ],
